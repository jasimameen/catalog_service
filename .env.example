# Copy to .env.local and fill in. Never commit the real file (already gitignored).

# --- Supabase (required) ---
# Settings → API Keys. Copy Project URL, Publishable key, and Secret key.
# Set BOTH the new names AND the NEXT_PUBLIC_ aliases so client + server work.
# Old names (NEXT_PUBLIC_SUPABASE_ANON_KEY, SUPABASE_SERVICE_ROLE_KEY) still work.

SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co

SUPABASE_PUBLISHABLE_KEY=eyJ...
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=eyJ...

# Replace your-secret-key with the real Secret key from the dashboard (server-only).
SUPABASE_SECRET_KEY=your-secret-key

# --- Routing (required) ---
# localhost:3000 locally. On Vercel set catalog.hevyf.com (see DEPLOY.md).
NEXT_PUBLIC_ROOT_DOMAIN=localhost:3000

# --- Order / OTP emails (optional — checkout still saves the order without these) ---
# Google Workspace SMTP relay. FROM must be an address in your Workspace domain.
SMTP_HOST=smtp-relay.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_SECURE=false
ORDER_FROM_EMAIL=

# --- Billing (Lemon Squeezy, $24.99/month) ---
# Create a store + product "Instant Catalog" with a $24.99 monthly variant.
# Price change: edit the existing variant in the Lemon Squeezy dashboard.
# Do not mint a new variant ID or rotate secrets for a price-only change.
# Optional: INQUIRY_NOTIFY_EMAIL=jasim@hevyf.com (comma-separated). Defaults to jasim@hevyf.com.
INQUIRY_NOTIFY_EMAIL=
# Then paste Store ID, API key, variant ID, and webhook signing secret.
# VARIANT_ID is the variant's Copy ID (not the product ID in the URL).
# Test API keys only work with Test-mode variants; Live keys with Live variants.
# Webhook URL in Lemon Squeezy: https://catalog.hevyf.com/api/billing/webhook
LEMONSQUEEZY_API_KEY=
LEMONSQUEEZY_STORE_ID=
LEMONSQUEEZY_VARIANT_ID=
LEMONSQUEEZY_WEBHOOK_SECRET=
# LEMONSQUEEZY_WEBHOOK_URL=https://catalog.hevyf.com/api/billing/webhook

# --- Custom domains ---
# Check now verifies DNS only. Optional Vercel tokens later if merchants want auto-cert custom domains.
DOMAIN_PROVIDER=manual

# --- Push notifications (Instant Catalog Ops + admin PWA) ---
# From the Firebase console: Project settings -> Service accounts ->
# Generate new private key. Paste the three matching fields below (the key
# keeps its literal \n sequences — do not reformat it into a real newline).
# Until these are set, sendPushToAccount() logs and returns not_configured —
# FCM never leaves the server. Same service account as the Android app.
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=

# Web / PWA (same hv-catalog-service project as mobile-app).
# Firebase console -> Add app -> Web, then Cloud Messaging -> Web Push certificates.
# Public client values only — never put the service-account private key here.
# Project id / sender id / api key already exist on the Android app
# (mobile-app/android/app/google-services.json). You still need a Web app ID
# and the VAPID key. Until APP_ID + VAPID are set, Notify still enables
# in-tab alerts; background Home Screen push stays off.
# NEXT_PUBLIC_FIREBASE_API_KEY=
# NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=hv-catalog-service.firebaseapp.com
# NEXT_PUBLIC_FIREBASE_PROJECT_ID=hv-catalog-service
# NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=742438149734
# NEXT_PUBLIC_FIREBASE_APP_ID=
# NEXT_PUBLIC_FIREBASE_VAPID_KEY=
