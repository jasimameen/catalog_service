# Copy to .env.local and fill in. Never commit the real file (already gitignored).

# --- Supabase (required) ---
# Settings → API Keys. Copy Project URL, Publishable key, and Secret key.
# Set BOTH the new names AND the NEXT_PUBLIC_ aliases so client + server work.
# Old names (NEXT_PUBLIC_SUPABASE_ANON_KEY, SUPABASE_SERVICE_ROLE_KEY) still work.

SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co

SUPABASE_PUBLISHABLE_KEY=eyJ...
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=eyJ...

# Replace your-secret-key with the real Secret key from the dashboard (server-only).
SUPABASE_SECRET_KEY=your-secret-key

# --- Routing (required) ---
# localhost:3000 locally. On Vercel set catalog.hevyf.com (see DEPLOY.md).
NEXT_PUBLIC_ROOT_DOMAIN=localhost:3000

# --- Order emails (optional — checkout still saves the order without these) ---
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_SECURE=false
ORDER_FROM_EMAIL=

# --- Custom domains ---
# Production on Vercel: DOMAIN_PROVIDER=vercel (happy path). See DEPLOY.md.
# Locally you can leave this as vercel or use manual. cloudflare: CLOUDFLARE.md.
DOMAIN_PROVIDER=vercel

# Needed in Vercel if merchants add their own domains (auto-cert).
VERCEL_API_TOKEN=
VERCEL_PROJECT_ID=
VERCEL_TEAM_ID=

# cloudflare mode
CLOUDFLARE_API_TOKEN=
CLOUDFLARE_ZONE_ID=
CLOUDFLARE_FALLBACK_ORIGIN=edge.catalog.hevyf.com
